# ==============================================================
# Ambiente LOCAL de pruebas (docker-compose.local.yml).
# Copiar a .env.local (no se versiona) y poner contraseñas propias:
#   cp .env.local.example .env.local
# MySQL local desechable con AMBOS esquemas poblados desde
# BaseDatosMySQL/desarrollo/ — datos sintéticos, sin datos reales.
# ==============================================================

# --- MySQL local (contenedor db) ---
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-local

# --- BD propia del SGT (gestionturnos) — R/W ---
DB_URL=jdbc:mysql://db:3306/gestionturnos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Santiago
DB_USERNAME=root
DB_PASSWORD=cambiar-esta-clave-local

# --- BD del hospital (innhosp / viewPersonal) — solo lectura ---
HOSPITAL_DB_URL=jdbc:mysql://db:3306/innhosp?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Santiago
HOSPITAL_DB_USERNAME=root
HOSPITAL_DB_PASSWORD=cambiar-esta-clave-local

# --- Hibernate ---
# 'validate': la app solo verifica que el esquema cargado por los scripts
# calce con las entidades. Si falla, el desajuste es un hallazgo real.
DDL_AUTO=validate

# --- Seguridad ---
# Generar uno propio: openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# localhost (no 127.0.0.1): es el origen con que se abre el frontend de desarrollo.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
LOGIN_LOCK_DURATION_MS=900000
SWAGGER_ENABLED=true
SERVER_ID=local

# --- Frontend ---
VITE_API_BASE_URL=/api/v2
VITE_DEBUG=true
VITE_SOCKET_URL=

# --- Simulador del padron (SOLO DEMO; perfil "demo" del compose, no arranca solo) ---
# Ver simulador-padron/README.md. Si falta alguna de estas variables el servicio NO arranca.
# Usuario MySQL propio (PADRON_DB_USER vacio = padron_demo):
#   bash scripts/crear_usuario_padron_demo.sh local
PADRON_DB_USER=
PADRON_DB_PASSWORD=
PADRON_ADMIN_USER=
PADRON_ADMIN_PASSWORD=
# PADRON_BIND=127.0.0.1
# PADRON_PUBLIC_PORT=8091
