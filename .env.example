# =====================================================
# Plantilla de variables de entorno para docker-compose.yml (PRODUCCIÓN)
# Copia este archivo como `.env` y rellena los valores reales.
#   cp .env.example .env
# El archivo `.env` está ignorado por Git (no se versiona) — NO pongas secretos aquí.
# =====================================================

# --- Base de datos MySQL
# host.docker.internal apunta al PC anfitrión desde los contenedores.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=innhosp2
DB_USERNAME=root
# Contraseña del usuario de MySQL. En .env pon la contraseña real de tu BD.
DB_PASSWORD=cambia_esta_password

# --- Hibernate ---
# update | validate | none  (para producción real se recomienda 'validate')
DDL_AUTO=update

# --- Seguridad JWT ---
# Secreto de firma de los tokens. Debe ser largo (>= 32 caracteres) y aleatorio.
# Genera uno nuevo, por ejemplo: openssl rand -base64 48
JWT_SECRET=genera_un_secreto_largo_y_aleatorio

# --- Frontend (opcional) ---
# Ruta base de la API que usa el build del frontend. Déjala relativa para que
# funcione detrás del balanceador desde cualquier dispositivo de la red.
VITE_API_BASE_URL=/api/v2
