# =====================================================
# Plantilla de variables de entorno para docker-compose.yml (PRODUCCIÓN)
# Copia este archivo como `.env` y rellena los valores reales.
#   cp .env.example .env
# El archivo `.env` está ignorado por Git (no se versiona) — NO pongas secretos aquí.
# =====================================================

# --- BD propia del SGT (gestionturnos) — datasource primario (lectura/escritura) ---
DB_URL=jdbc:mysql://host.docker.internal:3306/gestionturnos
DB_USERNAME=cambia_esta_username
DB_PASSWORD=cambia_esta_password

# --- BD del hospital (viewPersonal) — datasource secundario, SOLO LECTURA ---
# Conexión provista por el hospital (usuario con solo SELECT sobre viewPersonal).
HOSPITAL_DB_URL=jdbc:mysql://HOST_HOSPITAL:3307/innhosp
HOSPITAL_DB_USERNAME=cambia_esta_username_del_hospital
HOSPITAL_DB_PASSWORD=cambia_esta_password_del_hospital

# --- Hibernate (BD de la app) ---
# update | validate | none. En producción la BD (y su esquema) la crea el hospital,
# así que la app solo VERIFICA con 'validate' (no modifica el esquema).
DDL_AUTO=validate

# --- Seguridad JWT ---
# Secreto de firma de los tokens. Debe ser largo (>= 32 caracteres) y aleatorio.
# Genera uno nuevo, por ejemplo: openssl rand -base64 48
JWT_SECRET=genera_un_secreto_largo_y_aleatorio

# --- CORS (SEC-002) ---
# Orígenes exactos permitidos para llamar a la API, separados por coma.
# En producción: el/los dominio(s) públicos reales del frontend (con esquema https://).
# NO uses comodines de red privada (192.168.*.*) ni el mismo valor de desarrollo en producción.
CORS_ALLOWED_ORIGINS=https://tu-dominio-de-produccion

# --- Bloqueo de fuerza bruta en login (SEC-009) ---
# Milisegundos que un RUT queda bloqueado tras agotar los intentos permitidos. 900000 = 15 minutos.
LOGIN_LOCK_DURATION_MS=900000

# --- Frontend (opcional) ---
# Ruta base de la API que usa el build del frontend. Déjala relativa para que
# funcione detrás del balanceador desde cualquier dispositivo de la red.
VITE_API_BASE_URL=/api/v2
