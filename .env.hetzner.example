# ==============================================================
# Plantilla del despliegue en la VM propia (docker-compose.hetzner.yml).
#   cp .env.hetzner.example .env.hetzner   y completar los valores.
# .env.hetzner está ignorado por Git — NUNCA pongas secretos en este ejemplo.
#
# Generar los tres secretos de una vez:
#   for n in MYSQL_ROOT_PASSWORD DB_PASSWORD HOSPITAL_DB_PASSWORD; do echo "$n=$(openssl rand -base64 24 | tr -d '/+=')"; done
#   echo "JWT_SECRET=$(openssl rand -base64 48)"
# ==============================================================

# --- MySQL (contenedor propio, no expuesto a internet) ---
MYSQL_ROOT_PASSWORD=

# --- Usuario de la BD de la app (R/W solo en gestionturnos) ---
DB_USERNAME=sgt_app
DB_PASSWORD=

# --- Usuario de la "BD del hospital" (SELECT solo sobre innhosp.viewPersonal) ---
# Es un usuario DISTINTO al de la app a propósito: el datasource del hospital
# es de solo lectura por diseño y así lo refuerza también la BD.
HOSPITAL_DB_USERNAME=sgt_hospital_ro
HOSPITAL_DB_PASSWORD=

# --- JWT: mínimo 32 caracteres, aleatorio y distinto por ambiente ---
JWT_SECRET=

# --- Origen público exacto desde el que el navegador carga la app ---
# Debe coincidir con lo que se ve en la barra del navegador, con esquema y puerto.
# Directo por IP:   http://167.233.77.149:8090
# Con dominio+TLS:  https://sgt.tudominio.cl
CORS_ALLOWED_ORIGINS=http://167.233.77.149:8090

# --- Publicación del puerto del frontend ---
# 0.0.0.0 = accesible desde internet por IP:puerto (necesita abrir el firewall).
# 127.0.0.1 = solo local; úsalo cuando delante haya un reverse proxy en la VM.
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT=8090

# --- Opcionales ---
LOGIN_LOCK_DURATION_MS=900000
BACKUP_DIR=./backups
RETENTION_DAYS=7
